# Copy to .env and adjust. Consumed by docker-compose.yml.

# Wolf + Wolf Den image. Leave as-is to build locally (docker compose build),
# or point at a published tag/digest for reproducibility.
WOLF_IMAGE=ghcr.io/games-on-whales/wolf-proxmox:latest

# Static LAN IP for the Wolf CT, as CIDR — required for Moonlight/mDNS
# discovery. Must be free on your LAN and match the daemon's --lan-* bridge.
WOLF_LAN_IP=192.168.1.50/24

# Proxmox storage for the Wolf CT rootfs and every session CT.
DLD_STORAGE=local-lvm

# DRM render node Wolf uses (vendor detection + virtual desktops). Find yours:
#   ls -l /sys/class/drm/renderD*/device/driver
WOLF_RENDER_NODE=/dev/dri/renderD128
# Separate encoder node; leave empty to reuse the render node.
WOLF_ENCODER_NODE=

# Identity-mapped runtime dir (host == container path). Sockets Wolf mounts
# into session CTs resolve here on the host.
WOLF_RUNTIME_DIR=/run/wolf

# Tag for the GOW app images (firefox, steam, ...) seeded into config.toml.
WOLF_IMAGE_TAG=fedora-43

WOLF_LOG_LEVEL=INFO
WOLF_STOP_CONTAINER_ON_EXIT=TRUE

# --- NVIDIA only (docker-compose.nvidia.yml) ---
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
